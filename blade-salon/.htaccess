DirectoryIndex index.html
<IfModule mod_alias.c>
  RedirectMatch 301 ^/loreal-professionnel-pro-fiber/?$ /products/#loreal
  RedirectMatch 301 ^/pureology/?$ /products/#pureology
  RedirectMatch 301 ^/moroccanoil/?$ /products/#moroccanoil
  RedirectMatch 301 ^/dermalogica/?$ /products/#dermalogica
  RedirectMatch 301 ^/opi/?$ /products/#opi
  RedirectMatch 301 ^/gehwol/?$ /products/#gehwol
  RedirectMatch 301 ^/acknowledgements/?$ /about/#photography
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
